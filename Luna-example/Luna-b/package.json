{
  "name": "framevault",
  "version": "1.0.0",
  "description": "Dependency-free TypeScript library and CLI for encoding and decoding binary data frames.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "framevault": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test test/framevault.test.ts"
  }
}
