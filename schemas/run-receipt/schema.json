{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-luna.dev/schemas/run-receipt/v0.3.json",
  "title": "Evaluation run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_id", "task_fixture_sha256", "run_status", "adapter_status", "configured_verifier", "claim_evaluation", "terminal_evidence_status", "intervention", "model", "model_snapshot", "reasoning_effort", "prompt_sha256", "skill_sha256", "repository_commit", "isolation", "environment", "evaluator_boundary", "started_at", "finished_at", "duration_ms", "usage", "cost_usd", "cost_accuracy", "billing_records", "omitted_charge_categories", "trace_hash", "artifacts", "claims", "error_codes"],
  "properties": {
    "schema_version": { "const": "0.3" },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_fixture_sha256": { "$ref": "#/$defs/sha256" },
    "run_status": { "enum": ["completed", "error", "cancelled"] },
    "adapter_status": { "$ref": "#/$defs/processStatus" },
    "configured_verifier": {
      "type": "object", "additionalProperties": false, "required": ["status", "exit_code"],
      "properties": { "status": { "enum": ["passed", "failed", "not_run"] }, "exit_code": { "type": ["integer", "null"] } }
    },
    "claim_evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evaluated_claim_count", "total_claim_count"],
      "properties": {
        "status": { "enum": ["not_evaluated", "partially_evaluated", "evaluated"] },
        "evaluated_claim_count": { "type": "integer", "minimum": 0 },
        "total_claim_count": { "type": "integer", "minimum": 0 }
      }
    },
    "terminal_evidence_status": { "enum": ["not_evaluated", "insufficient", "satisfied", "waived"] },
    "intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["treatment_id", "design", "packet_file_sha256", "packet_content_sha256", "review_file_sha256"],
      "properties": {
        "treatment_id": { "$ref": "#/$defs/treatment" },
        "design": { "type": ["string", "null"], "enum": ["cumulative", "independent", null] },
        "packet_file_sha256": { "$ref": "#/$defs/nullableSha256" },
        "packet_content_sha256": { "$ref": "#/$defs/nullableSha256" },
        "review_file_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "model": { "type": "string", "minLength": 1 },
    "model_snapshot": { "type": "string", "minLength": 1 },
    "reasoning_effort": { "type": "string", "minLength": 1 },
    "prompt_sha256": { "$ref": "#/$defs/sha256" },
    "skill_sha256": { "$ref": "#/$defs/nullableSha256" },
    "repository_commit": { "type": "string", "minLength": 1 },
    "isolation": { "enum": ["filesystem_copy_only", "security_sandbox"] },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "definition_sha256", "image_digest", "platform", "architecture", "node_version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "definition_sha256": { "$ref": "#/$defs/sha256" },
        "image_digest": { "type": ["string", "null"], "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "node_version": { "type": "string", "minLength": 1 }
      }
    },
    "evaluator_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "detached_workspace", "filtered_environment", "treatment_metadata_declared", "canary_count"],
      "properties": {
        "classification": { "enum": ["interface_blind_host_confidentiality_not_enforced", "confidentiality_enforced"] },
        "detached_workspace": { "type": "boolean" },
        "filtered_environment": { "type": "boolean" },
        "treatment_metadata_declared": { "const": false },
        "canary_count": { "type": "integer", "minimum": 0 }
      }
    },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "usage": { "$ref": "#/$defs/usage" },
    "cost_usd": { "type": "number", "minimum": 0 },
    "cost_accuracy": { "enum": ["exact_provider_reported", "reconstructed", "estimated", "not_applicable"] },
    "billing_records": { "type": "array", "items": { "$ref": "#/$defs/billingRecord" } },
    "omitted_charge_categories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "trace_hash": { "$ref": "#/$defs/sha256" },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "claims": { "type": "array", "items": { "type": "string" } },
    "error_codes": { "type": "array", "items": { "type": "string", "pattern": "^OML_[A-Z0-9_]+$" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "treatment": { "enum": ["native", "lean_skill", "equal_token", "equal_cost", "L1_context", "L2_localization", "L3_observation", "L4_diagnosis", "L5_plan", "verification_gap"] },
    "processStatus": {
      "type": "object", "additionalProperties": false, "required": ["status", "exit_code"],
      "properties": { "status": { "enum": ["passed", "failed", "not_run"] }, "exit_code": { "type": ["integer", "null"] } }
    },
    "usage": {
      "type": "object", "additionalProperties": false, "required": ["input_tokens", "cached_input_tokens", "output_tokens"],
      "properties": { "input_tokens": { "type": "integer", "minimum": 0 }, "cached_input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 } }
    },
    "billingRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "service_tier", "input_tokens", "cached_input_tokens", "cache_write_tokens", "output_tokens", "long_context_applied", "token_cost_usd", "tool_cost_usd", "specialist_cost_usd", "total_cost_usd", "source"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 }, "service_tier": { "type": "string", "minLength": 1 },
        "input_tokens": { "type": "integer", "minimum": 0 }, "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 },
        "long_context_applied": { "type": "boolean" }, "token_cost_usd": { "type": "number", "minimum": 0 },
        "tool_cost_usd": { "type": "number", "minimum": 0 }, "specialist_cost_usd": { "type": "number", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0 },
        "source": { "enum": ["provider_response", "provider_invoice", "reconstructed", "estimate", "test_double"] }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["kind", "sha256", "bytes", "relative_path"],
      "properties": { "kind": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 }, "relative_path": { "type": "string", "minLength": 1 } }
    }
  }
}
