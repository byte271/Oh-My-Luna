{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-luna.dev/schemas/model-response/v0.json",
  "title": "External model adapter response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files", "claims", "usage", "billing"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string" }
        }
      }
    },
    "claims": { "type": "array", "items": { "type": "string" } },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "billing": {
      "type": "object", "additionalProperties": false,
      "required": ["accuracy", "records", "omitted_charge_categories"],
      "properties": {
        "accuracy": { "enum": ["exact_provider_reported", "reconstructed", "estimated", "not_applicable"] },
        "records": { "type": "array", "items": { "$ref": "#/$defs/billingRecord" } },
        "omitted_charge_categories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "raw_trace": {}
  },
  "$defs": {
    "billingRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "service_tier", "input_tokens", "cached_input_tokens", "cache_write_tokens", "output_tokens", "long_context_applied", "token_cost_usd", "tool_cost_usd", "specialist_cost_usd", "total_cost_usd", "source"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "service_tier": { "type": "string", "minLength": 1 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "long_context_applied": { "type": "boolean" },
        "token_cost_usd": { "type": "number", "minimum": 0 },
        "tool_cost_usd": { "type": "number", "minimum": 0 },
        "specialist_cost_usd": { "type": "number", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0 },
        "source": { "enum": ["provider_response", "provider_invoice", "reconstructed", "estimate", "test_double"] }
      }
    }
  }
}
