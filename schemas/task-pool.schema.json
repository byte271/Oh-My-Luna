{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-luna.dev/schemas/task-pool/v0.1",
  "title": "Pre-treatment candidate task pool",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "pool_id", "constructed_at", "selection_rule_version", "candidates"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "pool_id": { "$ref": "#/$defs/id" },
    "constructed_at": { "type": "string", "minLength": 1 },
    "selection_rule_version": { "type": "string", "minLength": 1 },
    "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/candidate" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository", "task_source", "task_statement", "task_family", "language", "estimated_human_difficulty", "visible_tests", "hidden_verifier", "environment", "licensing", "contamination", "mechanics", "selection"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repository": {
          "type": "object", "additionalProperties": false, "required": ["organization", "name", "base_commit", "fixed_commit"],
          "properties": { "organization": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "base_commit": { "type": "string", "minLength": 7 }, "fixed_commit": { "type": "string", "minLength": 7 } }
        },
        "task_source": {
          "type": "object", "additionalProperties": false, "required": ["kind", "url"],
          "properties": { "kind": { "enum": ["issue", "pull_request", "commit", "curated"] }, "url": { "type": "string", "minLength": 1 } }
        },
        "task_statement": { "type": "string", "minLength": 1 },
        "task_family": { "enum": ["bug_fix", "ci_failure", "regression", "security", "compatibility"] },
        "language": { "enum": ["python", "typescript", "javascript"] },
        "estimated_human_difficulty": { "enum": ["small", "medium", "large"] },
        "visible_tests": { "$ref": "#/$defs/strings" },
        "hidden_verifier": {
          "type": "object", "additionalProperties": false, "required": ["available", "sha256"],
          "properties": { "available": { "type": "boolean" }, "sha256": { "$ref": "#/$defs/nullableSha256" } }
        },
        "environment": {
          "type": "object", "additionalProperties": false, "required": ["reproducible", "definition_sha256"],
          "properties": { "reproducible": { "type": "boolean" }, "definition_sha256": { "$ref": "#/$defs/sha256" } }
        },
        "licensing": {
          "type": "object", "additionalProperties": false, "required": ["spdx", "redistribution_permitted"],
          "properties": { "spdx": { "type": "string", "minLength": 1 }, "redistribution_permitted": { "type": "boolean" } }
        },
        "contamination": {
          "type": "object", "additionalProperties": false, "required": ["risk", "notes"],
          "properties": { "risk": { "enum": ["low", "medium", "high"] }, "notes": { "type": "string" } }
        },
        "mechanics": {
          "type": "object", "additionalProperties": false, "required": ["base_fails_hidden_verifier", "fixed_passes_hidden_verifier", "infrastructure_valid", "original_failure_evidence_ref", "fixed_success_evidence_ref"],
          "properties": {
            "base_fails_hidden_verifier": { "type": "boolean" }, "fixed_passes_hidden_verifier": { "type": "boolean" }, "infrastructure_valid": { "type": "boolean" },
            "original_failure_evidence_ref": { "type": "string", "minLength": 1 }, "fixed_success_evidence_ref": { "type": "string", "minLength": 1 }
          }
        },
        "selection": {
          "type": "object", "additionalProperties": false, "required": ["status", "exclusion_reason", "selected_at"],
          "properties": { "status": { "enum": ["candidate", "included", "excluded"] }, "exclusion_reason": { "type": ["string", "null"] }, "selected_at": { "type": ["string", "null"] } }
        }
      }
    }
  }
}
