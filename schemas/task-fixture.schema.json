{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-luna.dev/schemas/task-fixture/v0.2.json",
  "title": "Oh-My-Luna evaluation task fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "issue", "repository", "adapter", "environment", "confidentiality", "verifier", "limits", "requires_security_sandbox"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "issue": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "model", "model_snapshot", "reasoning_effort", "service_tier", "prompt_sha256", "skill_sha256", "rates_usd_per_million_tokens"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "$ref": "#/$defs/argv" },
        "model": { "type": "string", "minLength": 1 },
        "model_snapshot": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "type": "string", "minLength": 1 },
        "service_tier": { "enum": ["standard", "batch", "flex", "fast", "custom", "not_applicable"] },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "skill_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "environment_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "rates_usd_per_million_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "cached_input", "output"],
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "cached_input": { "type": "number", "minimum": 0 },
            "output": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["id", "definition_sha256", "image_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "definition_sha256": { "$ref": "#/$defs/sha256" },
        "image_digest": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "confidentiality": {
      "type": "object", "additionalProperties": false, "required": ["hidden_paths"],
      "properties": { "hidden_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "success_exit_codes"],
      "properties": {
        "command": { "$ref": "#/$defs/argv" },
        "success_exit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_timeout_ms", "verifier_timeout_ms", "max_output_bytes"],
      "properties": {
        "adapter_timeout_ms": { "type": "integer", "minimum": 1 },
        "verifier_timeout_ms": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "requires_security_sandbox": { "type": "boolean" },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
      }
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
