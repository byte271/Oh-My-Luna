{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-luna.dev/schemas/gate-m-study-freeze/v0.1",
  "title": "Canonical identity for a Gate M method-validation corpus",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "freeze_id", "created_at", "phase", "status", "capability_claim_permitted", "code_identity", "model_execution", "review", "treatment_execution", "scorer", "pricing", "tasks", "artifacts", "aggregate_sha256"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "freeze_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "phase": { "const": "gate_m_method_validation" },
    "status": { "enum": ["pre_review", "executable"] },
    "capability_claim_permitted": { "const": false },
    "code_identity": { "type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": { "commit": { "type": "string", "minLength": 7 }, "tree": { "type": "string", "minLength": 7 } } },
    "model_execution": { "type": "object", "additionalProperties": false, "required": ["live_model_calls", "adapter_id", "adapter_sha256", "model_snapshot", "reasoning_effort", "prompt_sha256", "skill_sha256"], "properties": {
      "live_model_calls": { "const": false }, "adapter_id": { "const": "deterministic-test-double" }, "adapter_sha256": { "$ref": "#/$defs/sha256" },
      "model_snapshot": { "const": "test-double/not-a-model@fixture-1" }, "reasoning_effort": { "const": "none" }, "prompt_sha256": { "$ref": "#/$defs/nullableSha256" }, "skill_sha256": { "$ref": "#/$defs/nullableSha256" }
    } },
    "review": { "type": "object", "additionalProperties": false, "required": ["policy_sha256", "blinded_schedule_sha256", "required_distinct_reviewers", "completed_distinct_reviewers", "agreement_status"], "properties": {
      "policy_sha256": { "$ref": "#/$defs/sha256" }, "blinded_schedule_sha256": { "$ref": "#/$defs/sha256" }, "required_distinct_reviewers": { "type": "integer", "minimum": 1 }, "completed_distinct_reviewers": { "type": "integer", "minimum": 0 }, "agreement_status": { "enum": ["pending", "complete"] }
    } },
    "treatment_execution": { "type": "object", "additionalProperties": false, "required": ["executable", "schedule_sha256", "blocked_by"], "properties": { "executable": { "type": "boolean" }, "schedule_sha256": { "$ref": "#/$defs/nullableSha256" }, "blocked_by": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "scorer": { "type": "object", "additionalProperties": false, "required": ["source_path", "source_sha256", "classification"], "properties": { "source_path": { "$ref": "#/$defs/path" }, "source_sha256": { "$ref": "#/$defs/sha256" }, "classification": { "enum": ["interface_blind_host_confidentiality_not_enforced", "confidentiality_enforced"] } } },
    "pricing": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "snapshot_id"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" }, "snapshot_id": { "type": "string", "minLength": 1 } } },
    "tasks": { "type": "array", "minItems": 4, "maxItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["task_id", "manifest_sha256", "base_commit", "corrected_commit", "evaluator_sha256", "environment_definition_sha256"], "properties": { "task_id": { "type": "string", "minLength": 1 }, "manifest_sha256": { "$ref": "#/$defs/sha256" }, "base_commit": { "type": "string", "minLength": 7 }, "corrected_commit": { "type": "string", "minLength": 7 }, "evaluator_sha256": { "$ref": "#/$defs/sha256" }, "environment_definition_sha256": { "$ref": "#/$defs/sha256" } } } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"], "properties": { "role": { "enum": ["task", "intervention_draft", "review", "evaluator", "environment", "pricing", "scorer", "protocol", "adapter", "schedule", "code"] }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" } } } },
    "aggregate_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
  }
}
